# SayLess Configuration
# Copy to .env and customize

# STT (faster-whisper tiny.en, Enter to start/stop recording)
SAYLESS_STT_ENABLED=true
SAYLESS_STT_ENGINE=faster-whisper
SAYLESS_STT_MODEL=tiny.en
SAYLESS_STT_DEVICE=cpu
# CoralBoard ALSA capture device used by arecord.
SAYLESS_STT_AUDIO_DEVICE=hw:1,0

# LLM (LiteRT-LM / Gemma 3 270M on CoralBoard)
# Any LiteRT-LM chat model works. A FunctionGemma fine-tune gives better tool calling.
SAYLESS_LLM_ENABLED=true
SAYLESS_LLM_ENGINE=litert-lm
SAYLESS_LLM_MODEL_NAME=mobile_actions_q8_ekv1024.litertlm
# Absolute path is best on the board.
SAYLESS_LLM_MODEL_PATH=/home/root/models/mobile_actions_q8_ekv1024.litertlm
SAYLESS_LLM_BASE_URL=http://localhost:8000/v1
SAYLESS_LLM_SERVER_HOST=127.0.0.1
SAYLESS_LLM_SERVER_PORT=8000
SAYLESS_LLM_TEMPERATURE=0.7
SAYLESS_LLM_TOP_P=0.95
SAYLESS_LLM_TOP_K=64

# Tools
SAYLESS_ENABLE_PHONE_TOOLS=true
SAYLESS_ENABLE_MAPS_TOOLS=true
SAYLESS_GOOGLE_VOICE_ENABLED=false
SAYLESS_GOOGLE_MAPS_API_KEY=
